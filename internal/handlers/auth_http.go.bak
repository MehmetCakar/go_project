package handlers

import (
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"example.com/ecom-go/internal/service"
)

type AuthHTTP struct {
	svc          *service.AuthService
	cookieDomain string
	cookieSecure bool
}

func NewAuthHTTP(svc *service.AuthService) *AuthHTTP {
	return &AuthHTTP{
		svc:          svc,
		cookieDomain: "",
		cookieSecure: true,
	}
}

func (h *AuthHTTP) setCookie(c *gin.Context, token string, ttl time.Duration) {
	maxAge := int(ttl / time.Second)
	c.SetSameSite(http.SameSiteLaxMode)
	c.SetCookie("access_token", token, maxAge, "/", h.cookieDomain, h.cookieSecure, true)
}

// POST /api/register  {email}
func (h *AuthHTTP) Register(c *gin.Context) {
	var in struct {
		Email string json:"email"
	}
	if err := c.ShouldBindJSON(&in); err != nil || in.Email == "" {
		c.JSON(http.StatusBadRequest, gin.H{"ok": false, "error": "email required"})
		return
	}
	_ = h.svc.Register(c, in.Email)
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

// POST /api/resend {email}
func (h *AuthHTTP) Resend(c *gin.Context) {
	var in struct {
		Email string json:"email"
	}
	if err := c.ShouldBindJSON(&in); err != nil || in.Email == "" {
		c.JSON(http.StatusBadRequest, gin.H{"ok": false, "error": "email required"})
		return
	}
	_ = h.svc.Resend(c, in.Email)
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

// POST /api/verify {email, code}
func (h *AuthHTTP) Verify(c *gin.Context) {
	var in struct {
		Email string json:"email"
		Code  string json:"code"
	}
	if err := c.ShouldBindJSON(&in); err != nil || in.Email == "" || in.Code == "" {
		c.JSON(http.StatusBadRequest, gin.H{"ok": false, "error": "email & code required"})
		return
	}
	if err := h.svc.Verify(c, in.Email, in.Code); err != nil {
		c.JSON(http.StatusUnauthorized, gin.H{"ok": false, "error": "invalid or expired code"})
		return
	}
	// NOT: Burada login yapmyoruz. Kullanc login sayfasna gidecek.
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

// POST /api/login  {email,password}
func (h *AuthHTTP) Login(c *gin.Context) {
	var in struct {
		Email    string json:"email"
		Password string json:"password"
	}
	if err := c.ShouldBindJSON(&in); err != nil || in.Email == "" || in.Password == "" {
		c.JSON(http.StatusBadRequest, gin.H{"ok": false, "error": "email & password required"})
		return
	}

	if err := h.svc.Login(c, in.Email, in.Password); err != nil {
		switch err {
		case service.ErrInvalidCredentials:
			c.JSON(http.StatusUnauthorized, gin.H{"ok": false, "error": "invalid email or password"})
		case service.ErrNotVerified:
			c.JSON(http.StatusConflict, gin.H{"ok": false, "error": "email not verified"})
		default:
			c.JSON(http.StatusInternalServerError, gin.H{"ok": false, "error": "login failed"})
		}
		return
	}

	tok, err := h.svc.IssueJWT(in.Email, 30*24*time.Hour)
	if err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"ok": false, "error": "token"})
		return
	}
	h.setCookie(c, tok, 30*24*time.Hour)
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

// POST /api/logout {}
func (h *AuthHTTP) Logout(c *gin.Context) {
	c.SetSameSite(http.SameSiteLaxMode)
	c.SetCookie("access_token", "", -1, "/", h.cookieDomain, h.cookieSecure, true)
	c.JSON(http.StatusOK, gin.H{"ok": true})
}

// GET /api/me
func (h *AuthHTTP) Me(c *gin.Context) {
	tok, err := c.Cookie("access_token")
	if err != nil || tok == "" {
		c.JSON(http.StatusUnauthorized, gin.H{"ok": false, "error": "no auth"})
		return
	}
	email, err := h.svc.ParseJWT(tok)
	if err != nil {
		c.JSON(http.StatusUnauthorized, gin.H{"ok": false, "error": "invalid token"})
		return
	}
	c.JSON(http.StatusOK, gin.H{"ok": true, "email": email})
}
